# Server
PORT=4000
HOST=0.0.0.0

# Auth (optional -- defense-in-depth on top of Tailscale)
AUTH_TOKEN=

# ngrok (for dev server preview tunnels only)
NGROK_AUTHTOKEN=

# Cursor CLI (optional -- only needed if `agent login` hasn't been run)
CURSOR_API_KEY=

# Projects base directory to scan for the project picker
PROJECTS_DIR=/Users/username/GitHub

# Prompt timeout in milliseconds (default: 5 minutes)
PROMPT_TIMEOUT_MS=300000

# Per-request interactive timeout for permission/ask/plan dialogs (default: 2 minutes)
INTERACTIVE_TIMEOUT_MS=120000

# Grace period before auto-rejecting pending requests when all clients disconnect (default: 30s)
DISCONNECT_GRACE_MS=30000

# Agent CLI path if `agent` is not on PATH (Windows: e.g. %LOCALAPPDATA%\cursor-agent\agent.cmd)
AGENT_BIN=

# Log level (debug, info, warn, error)
LOG_LEVEL=info