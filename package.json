{
  "name": "@solixx/orbit",
  "version": "1.0.0",
  "description": "Self-hosted web UI for remote Cursor CLI access from phone/tablet",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solixx/Orbit.git"
  },
  "keywords": [
    "cursor",
    "cursor-cli",
    "cursor-agent",
    "remote",
    "mobile",
    "tablet",
    "ipad",
    "iphone",
    "tailscale",
    "self-hosted",
    "ai-coding",
    "pwa",
    "websocket",
    "express"
  ],
  "author": "Solixx (https://github.com/Solixx)",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.12.0"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Solixx/Orbit/issues"
  },
  "homepage": "https://github.com/Solixx/Orbit#readme",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
